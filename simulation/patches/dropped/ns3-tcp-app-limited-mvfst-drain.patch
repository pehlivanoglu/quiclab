 NS_OBJECT_ENSURE_REGISTERED(TcpSocketBase);
 
+// quiclab simulation patch 2 (mvfst-style application-limited mark), off by default.
+// mvfst 4b691f3 marks the connection application-limited at the end of every write round
+// that leaves less than one packet unsent, with no loss pending, while the window still
+// allows more (QuicTransportBaseLite.cpp:1899-1919 -> Bbr.cpp:648-656 setAppLimited ->
+// BbrBandwidthSampler.cpp:188-191). With this value true, the same check runs at the end
+// of SendPendingData, in addition to the Linux-style check in Send() (patch 1).
+// Set with NS_GLOBAL_VALUE="QuiclabAppLimitedAtDrain=1".
+static GlobalValue g_quiclabAppLimitedAtDrain("QuiclabAppLimitedAtDrain",
+                                              "quiclab: also mark app-limited when a write round "
+                                              "leaves less than one segment unsent (mvfst)",
+                                              BooleanValue(false),
+                                              MakeBooleanChecker());
+
+static bool
+QuiclabAppLimitedAtDrain()
+{
+    static const bool on = [] {
+        BooleanValue v;
+        g_quiclabAppLimitedAtDrain.GetValue(v);
+        return v.Get();
+    }();
+    return on;
+}
+
 TypeId
 TcpSocketBase::GetTypeId()
 {
